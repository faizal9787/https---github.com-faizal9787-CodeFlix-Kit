# Server Config
PORT=8000
NODE_ENV=development

# Database (Postgres)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=secret
DB_NAME=codeflix_db
# Pro-tip: Many Node libraries (like 'pg') prefer a single URL string
DATABASE_URL=postgres://postgres:secret@localhost:5432/codeflix_db

# Cache (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ML Microservices (The 3 Python Services)
SUPPORT_SERVICE_URL=http://localhost:8001
GRAMAVANI_SERVICE_URL=http://localhost:8002
PHARMACY_SERVICE_URL=http://localhost:8003